# Ignore large dataset folders
data/raw/
data/processed/

# Do NOT ignore manifests
!data/manifests/

# Explicitly track OSM gitkeep
!data/raw/OSM/
!data/raw/OSM/.gitkeep
data/raw/OSM/*.osm
data/raw/OSM/*.pbf
data/raw/OSM/*.xml

# Ignore python caches
__pycache__/
*.pyc

# Ignore ML output models and checkpoints locally
ml/export/*.tflite
ml/export/*.onnx
*.pth
*.pt

# Build directories
build/
cmake-build-*/
third_party/
eigen.zip

# C++ binaries
*.exe
*.dll
*.so
*.a
*.lib

# OS generated
.DS_Store
Thumbs.db

# Deployment artifacts
.vercel
.netlify

# Local SSL certificates
web/cert.pem
web/key.pem

# Runtime test outputs
outputs/
tests/test_outputs/